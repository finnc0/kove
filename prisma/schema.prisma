generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  name          String?
  password      String?
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  workspaces    Workspace[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?
  subscriptionStatus   String   @default("free")
  subscriptionTier     String   @default("explorer")
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd           Boolean  @default(false)
  lifetimeWorkspacesCreated   Int      @default(0)
}

model ProcessedWebhookEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id                 String   @id @default(cuid())
  userId             String
  name               String
  brief              String?
  status             String   @default("empty")
  findings           String?
  opportunitySnippet      String?
  lifetimeNodesCreated    Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodes                   Node[]
  canvasNotes        CanvasNote[]
  canvasGroups       CanvasGroup[]
  ideaNodes          IdeaNode[]
  buildPlan          BuildPlan?
}

model BuildPlan {
  id                 String      @id @default(cuid())
  workspaceId        String      @unique
  name               String      @default("My App")
  idea               String?
  ideaSourceGap      String?
  targetUser         String?
  coreValue          String?
  monetization       String?
  platform           String?
  designDirection    String?
  onboardingComplete Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  workspace          Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  features           Feature[]
  paywallRules       PaywallRule[]
  onboardingScreens  OnboardingScreen[]
  tiers              Tier[]
}

model Feature {
  id          String        @id @default(cuid())
  buildPlanId String
  title       String
  description String?
  category    String        @default("core")
  priority    Int           @default(0)
  columnId    String        @default("ideas")
  sourceGap   String?
  status      String        @default("planned")
  buildPrompt String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  buildPlan   BuildPlan     @relation(fields: [buildPlanId], references: [id], onDelete: Cascade)
  tierFeatures TierFeature[]
}

model PaywallRule {
  id              String    @id @default(cuid())
  buildPlanId     String
  tierName        String
  gatedFeatureIds String[]
  price           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  buildPlan       BuildPlan @relation(fields: [buildPlanId], references: [id], onDelete: Cascade)
}

model OnboardingScreen {
  id            String    @id @default(cuid())
  buildPlanId   String
  order         Int       @default(0)
  title         String
  type          String    @default("custom")
  purpose       String?
  wireframeJson Json?
  aiPrompt      String?
  paywallTierId String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  buildPlan     BuildPlan @relation(fields: [buildPlanId], references: [id], onDelete: Cascade)
  paywallTier   Tier?     @relation(fields: [paywallTierId], references: [id])
}

model Tier {
  id           String             @id @default(cuid())
  buildPlanId  String
  name         String
  order        Int                @default(0)
  prices       Json?
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  buildPlan    BuildPlan          @relation(fields: [buildPlanId], references: [id], onDelete: Cascade)
  tierFeatures TierFeature[]
  screens      OnboardingScreen[]
}

model TierFeature {
  id        String   @id @default(cuid())
  tierId    String
  featureId String
  createdAt DateTime @default(now())
  tier      Tier     @relation(fields: [tierId], references: [id], onDelete: Cascade)
  feature   Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([tierId, featureId])
}

model Node {
  id                   String    @id @default(cuid())
  workspaceId          String
  name                 String?
  type                 String    @default("ios")
  groupId              String?
  urlApp               String?
  urlSite              String?
  iconUrl              String?
  status               String    @default("pending")
  report               String?
  rawData              String?
  platformBadges       String?
  errorMessage         String?
  snapshotRatingCount  Int?
  snapshotDate         DateTime?
  estimateRefined      Boolean   @default(false)
  ratingHistory        Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  analyzedAt           DateTime?
  canvasX              Float?
  canvasY              Float?
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model CanvasNote {
  id             String    @id @default(cuid())
  workspaceId    String
  text           String    @default("")
  x              Float     @default(0)
  y              Float     @default(0)
  pinnedToNodeId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model CanvasGroup {
  id          String   @id @default(cuid())
  workspaceId String
  label       String   @default("New group")
  color       String   @default("zinc")
  nodeIds     String   @default("[]")
  x           Float    @default(100)
  y           Float    @default(100)
  collapsed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model ScrapedEstimate {
  id           String   @id @default(cuid())
  appStoreId   String
  country      String   @default("US")
  downloads    Int?
  revenue      Int?
  scrapedAt    DateTime @default(now())
  ok           Boolean
  error        String?

  @@unique([appStoreId, country])
}

model IdeaNode {
  id              String    @id @default(cuid())
  workspaceId     String
  text            String    @default("")
  targetUser      String?
  keyFeature      String?
  verdict         String?
  evaluationJson  String?
  x               Float     @default(600)
  y               Float     @default(100)
  lastEvaluatedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}
